---
import '../styles/about.css';
import Seo from '../components/Seo.astro';
import hiringImage from '../images/hiring_ad.jpg';
---

<html lang="en">
	<head>
		<!-- Google Tag Manager -->
		<script is:inline>
			(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
			new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
			j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
			'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
			})(window,document,'script','dataLayer','GTM-53ZPM8GP');
		</script>
		<!-- End Google Tag Manager -->
		<meta charset="utf-8" />
		<link rel="stylesheet" href="https://use.typekit.net/duj0xcr.css" />
		<meta name="viewport" content="width=device-width" />
		<Seo
			title="Careers at Marlowe | Join Our Team"
			description="Learn about hospitality careers at Marlowe on High Street in Christchurch and get in touch with our team."
			path="/careers/"
		/>
	</head>
	<body class="about-page careers-page">
		<!-- Google Tag Manager (noscript) -->
		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-53ZPM8GP"
		height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
		<!-- End Google Tag Manager (noscript) -->
		<header class="about-header" aria-label="Careers page header">
			<a class="about-header__link" href="/" data-about-exit>Back <span>Home</span></a>
			<a class="about-header__logo" href="/" aria-label="Marlowe home" data-about-exit>
				<span aria-hidden="true"></span>
			</a>
			<a
				class="about-header__link about-header__link--right"
				href="mailto:santiago@marlowe.co.nz?subject=Careers%20at%20Marlowe"
			>
				Get <span>In Touch</span>
			</a>
		</header>

		<main class="about-story" aria-label="Careers at Marlowe">
			<section class="about-poster careers-poster" aria-label="Marlowe careers artwork">
				<div class="about-poster__tiles" aria-hidden="true">
					<figure class="about-poster__tile">
						<img src={hiringImage.src} width={hiringImage.width} height={hiringImage.height} alt="" />
					</figure>
				</div>
			</section>

			<section class="about-editorial careers-editorial" aria-label="Marlowe careers and current vacancies">
				<div class="about-editorial__copy">

					<h1 class="careers-editorial__heading">
						Marlowe is <span class="type-serif">opening</span> on High Street this September, and we’re looking for the people who will work across our dining room and <span class="type-serif">bar</span>.
					</h1>
					<div class="about-editorial__divider" aria-hidden="true"></div>
					<p>
						Marlowe has been created by people who have spent their careers in <span class="type-serif">hospitality</span> and who will remain closely involved in its day-to-day operation. The people making the decisions will also be the people in the <span class="type-serif">kitchen</span>, on the floor, behind the bar and at the pass each day.
					</p>
					<p>
						Hospitality has been considered from the very beginning: how guests are <span class="type-serif">welcomed</span>, how the restaurant moves through the day and how it feels to work here.
					</p>
					<p>
						We want Marlowe to feel <span class="type-serif">warm, familiar</span> and confidently looked after. Polished, but never formal for the sake of it.
					</p>
					<p>
						We’re always looking for <span class="type-serif">talented, thoughtful</span> people who care about great food, warm service and making guests feel at home. If Marlowe sounds like the kind of place you’d like to work, we’d love to hear from you.
					</p>

					<div class="about-editorial__details" aria-label="Contact Marlowe">
						<h3 class="about-editorial__section-heading"><span>Contact</span> Us</h3>
						<div class="about-editorial__detail">
							<h3>General</h3>
							<p><a href="mailto:santiago@marlowe.co.nz?subject=Careers%20at%20Marlowe">santiago@marlowe.co.nz</a></p>
						</div>
						<div class="about-editorial__detail">
							<h3>Follow Us</h3>
							<p>
								<a href="https://www.instagram.com/marloweonhigh" target="_blank" rel="noopener noreferrer">
									Instagram
								</a>
							</p>
						</div>
					</div>
				</div>
			</section>
		</main>
		<span class="about-wordmark" aria-hidden="true"></span>

		<script>
			document.querySelectorAll('[data-about-exit]').forEach((link) => {
				link.addEventListener('click', (event) => {
					const href = link.getAttribute('href');
					if (!href) return;

					event.preventDefault();
					window.sessionStorage?.setItem('marloweTransition', 'to-home');
					document.body.dataset.aboutExit = 'true';
					window.setTimeout(() => {
						window.location.href = href;
					}, 520);
				});
			});
		</script>
	</body>
</html>
